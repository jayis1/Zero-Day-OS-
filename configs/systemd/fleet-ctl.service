[Unit]
Description=ZERO-DAY OS Fleet C2 Listener (fleet-ctl)
Documentation=https://github.com/jayis1/Zero-Day-OS-
After=network-online.target fleet-beacon.service
Wants=network-online.target

[Service]
Type=forking
PIDFile=/tmp/fleet-ctl-listener.pid
ExecStart=/usr/local/bin/fleet-ctl listen
ExecStop=/usr/local/bin/fleet-ctl stop
Restart=on-failure
RestartSec=15
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=append:/opt/cardputer/loot/general/fleet-ctl.log
StandardError=append:/opt/cardputer/loot/general/fleet-ctl.log

[Install]
WantedBy=multi-user.target
