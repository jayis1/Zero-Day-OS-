[Unit]
Description=ZERO-DAY OS On-Device Task Scheduler (zd-cron)
Documentation=https://github.com/jayis1/Zero-Day-OS-
After=network-online.target zeroday-boot.service
Wants=network-online.target

[Service]
Type=forking
PIDFile=/tmp/zd-cron.pid
ExecStartPre=/usr/local/bin/zd-cron init
ExecStart=/usr/local/bin/zd-cron start
ExecStop=/usr/local/bin/zd-cron stop
ExecReload=/usr/local/bin/zd-cron reload
Restart=on-failure
RestartSec=10
# Low priority — never steal CPU from actual tools
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Log everything to the unit journal
StandardOutput=append:/opt/cardputer/loot/general/zd-cron.log
StandardError=append:/opt/cardputer/loot/general/zd-cron.log

[Install]
WantedBy=multi-user.target
