#!/bin/bash
set -euo pipefail
# /usr/local/bin/zd-git-push
# Zero-Day OS — Push loot and changes to GitHub after cron/tool runs.
# Creates a new timestamped branch, commits all new/changed files in
# /opt/cardputer/loot/, /opt/cardputer/config/ (non-secret), and the
# repo itself, then pushes to origin.
#
# Usage: zd-git-push [message] [--loot-only | --repo-only | --all]
#
# Called automatically by zd-cron after each task run.
# Token stored in: /opt/cardputer/config/github_token.txt (chmod 600)
# Repo:            read from /opt/cardputer/config/github_repo.txt
#                  or $ZD_GITHUB_REPO env var

LOOT_DIR="/opt/cardputer/loot"
CONFIG_DIR="/opt/cardputer/config"
REPO_DIR="/opt/cardputer/repo"
TOKEN_FILE="${CONFIG_DIR}/github_token.txt"
REPO_FILE="${CONFIG_DIR}/github_repo.txt"
LOG="/opt/cardputer/loot/general/zd-git-push.log"

mkdir -p "$(dirname "$LOG")"

RED='\033[0;31m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log()  { echo "[$(date '+%H:%M:%S')] $*" | tee -a "$LOG"; }
ok()   { echo -e "${GREEN}[+]${NC} $*"   | tee -a "$LOG"; }
warn() { echo -e "${YELLOW}[!]${NC} $*"  | tee -a "$LOG"; }
err()  { echo -e "${RED}[!]${NC} $*"     | tee -a "$LOG"; }
info() { echo -e "${CYAN}[*]${NC} $*"    | tee -a "$LOG"; }

# ── Config ────────────────────────────────────────────────────────────────────

get_token() {
    if [ -n "${ZD_GITHUB_TOKEN:-}" ]; then echo "$ZD_GITHUB_TOKEN"; return; fi
    [ -r "$TOKEN_FILE" ] && cat "$TOKEN_FILE" && return
    return 1
}

get_repo() {
    if [ -n "${ZD_GITHUB_REPO:-}" ]; then echo "$ZD_GITHUB_REPO"; return; fi
    [ -r "$REPO_FILE" ] && cat "$REPO_FILE" && return
    # Try to read from git remote if we're inside a git repo
    git -C "${REPO_DIR:-$(pwd)}" remote get-url origin 2>/dev/null | \
        sed 's|https://.*@||;s|git@github.com:||;s|\.git$||' && return
    return 1
}

branch_name() {
    local ts
    ts=$(date +%Y%m%d-%H%M%S)
    local label="${1:-cron}"
    # Sanitise: only alphanum and dashes
    label=$(echo "$label" | tr ' ' '-' | tr -cd '[:alnum:]-' | head -c 30)
    echo "zd/${label}/${ts}"
}

# ── Loot git repo ─────────────────────────────────────────────────────────────
# We keep loot in a separate git repo at /opt/cardputer/repo
# so the OS repo and loot repo are separate concerns.

ensure_loot_repo() {
    local token="$1"
    local remote_repo="$2"

    mkdir -p "$REPO_DIR"
    if [ ! -d "$REPO_DIR/.git" ]; then
        info "Initialising loot git repo at $REPO_DIR"
        git init "$REPO_DIR" --quiet
        git -C "$REPO_DIR" config user.email "zeroday@cardputer"
        git -C "$REPO_DIR" config user.name "Zero-Day OS"
        # Create an initial empty commit so branches can be created
        git -C "$REPO_DIR" commit --allow-empty -m "init" --quiet
    fi

    # Set/update remote with token
    local remote_url="https://${token}@github.com/${remote_repo}.git"
    if git -C "$REPO_DIR" remote get-url origin &>/dev/null; then
        git -C "$REPO_DIR" remote set-url origin "$remote_url"
    else
        git -C "$REPO_DIR" remote add origin "$remote_url"
    fi
}

push_loot() {
    local token="$1"
    local remote_repo="$2"
    local commit_msg="$3"
    local branch
    branch=$(branch_name "loot")

    ensure_loot_repo "$token" "$remote_repo"

    # Symlink loot dirs into repo (don't copy — save flash wear)
    for subdir in wifi bt nfc ir rf cam recon creds general; do
        local src="$LOOT_DIR/$subdir"
        local dst="$REPO_DIR/$subdir"
        [ -d "$src" ] || continue
        [ -L "$dst" ] || [ -d "$dst" ] || ln -sf "$src" "$dst"
    done

    # Stage all new/changed loot (exclude binary files > 5MB and private key patterns)
    cd "$REPO_DIR"
    git checkout -b "$branch" --quiet 2>/dev/null || git checkout "$branch" --quiet

    # Add all loot except known-bad patterns
    git add --all 2>/dev/null || true

    # Remove staged secret patterns
    git diff --cached --name-only 2>/dev/null | while IFS= read -r f; do
        # Don't commit raw pcap > 5MB
        if [ -f "$f" ]; then
            local size
            size=$(stat -c%s "$f" 2>/dev/null || echo 0)
            if [ "$size" -gt 5242880 ] && [[ "$f" =~ \.(cap|pcap|iq|raw)$ ]]; then
                git reset HEAD "$f" --quiet 2>/dev/null || true
                warn "Skipping large binary: $f ($(( size / 1024 ))KB)"
            fi
        fi
    done

    local staged
    staged=$(git diff --cached --name-only 2>/dev/null | wc -l)
    if [ "$staged" -eq 0 ]; then
        info "No new loot to push"
        return 0
    fi

    git commit -m "$commit_msg" --quiet
    git push origin "$branch" --quiet \
        -u 2>/dev/null && ok "Loot pushed → branch: $branch" \
                       || { err "Push failed — check token/repo"; return 1; }
}

push_repo() {
    local token="$1"
    local remote_repo="$2"
    local commit_msg="$3"
    local branch
    branch=$(branch_name "os-changes")

    # Zero-Day OS repo lives at /opt/cardputer/Zero-Day-OS or wherever git root is
    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null || echo "/opt/cardputer/Zero-Day-OS")

    if [ ! -d "$repo_root/.git" ]; then
        warn "No git repo at $repo_root — skipping OS repo push"
        return 0
    fi

    cd "$repo_root"

    # Update remote URL with token
    git remote set-url origin "https://${token}@github.com/${remote_repo}.git"

    # Only push if there's anything staged or changed
    local dirty
    dirty=$(git status --porcelain 2>/dev/null | wc -l)
    if [ "$dirty" -eq 0 ]; then
        info "No changes in OS repo to push"
        return 0
    fi

    git checkout -b "$branch" 2>/dev/null || git checkout -b "$branch" HEAD 2>/dev/null || {
        warn "Could not create branch $branch — pushing to existing"
    }

    git add --all
    git commit -m "$commit_msg" --quiet
    git push origin "$branch" --quiet && ok "OS repo pushed → branch: $branch" \
                                       || err "OS repo push failed"
}

# ── Setup helpers ─────────────────────────────────────────────────────────────

cmd_setup() {
    mkdir -p "$CONFIG_DIR"
    echo -n "GitHub token (ghp_...): "
    read -rs token
    echo ""
    echo "$token" > "$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE"
    echo -n "GitHub repo (user/repo): "
    read -r repo
    echo "$repo" > "$REPO_FILE"
    chmod 600 "$REPO_FILE"
    ok "Saved token to $TOKEN_FILE"
    ok "Saved repo to $REPO_FILE"
    info "Test with: zd-git-push test"
}

cmd_status() {
    echo -e "${CYAN}[*] zd-git-push status${NC}"
    local token
    token=$(get_token 2>/dev/null || echo "")
    local repo
    repo=$(get_repo 2>/dev/null || echo "")
    [ -n "$token" ] && echo "  Token:  set ($(echo "$token" | head -c 8)...)" \
                    || echo -e "  Token:  ${RED}not set${NC}  (run: zd-git-push setup)"
    [ -n "$repo" ]  && echo "  Repo:   $repo" \
                    || echo -e "  Repo:   ${RED}not set${NC}  (run: zd-git-push setup)"
    echo "  Log:    $LOG"
    echo ""
    echo "  Recent pushes:"
    tail -5 "$LOG" 2>/dev/null || echo "  (no log yet)"
}

# ── Main ──────────────────────────────────────────────────────────────────────

MSG="${1:-cron run $(date +%Y-%m-%d\ %H:%M:%S)}"
MODE="${2:---all}"

case "$MSG" in
    setup|--setup)   cmd_setup; exit 0 ;;
    status|--status) cmd_status; exit 0 ;;
    test|--test)
        MSG="test push from $(hostname) at $(date)"
        MODE="--all"
        ;;
esac

TOKEN=$(get_token 2>/dev/null || true)
REPO=$(get_repo 2>/dev/null || true)

if [ -z "$TOKEN" ]; then
    err "No GitHub token. Run: zd-git-push setup  or  set ZD_GITHUB_TOKEN"
    exit 1
fi
if [ -z "$REPO" ]; then
    err "No GitHub repo. Run: zd-git-push setup  or  set ZD_GITHUB_REPO"
    exit 1
fi

log "Push triggered: msg='$MSG' mode=$MODE repo=$REPO"

case "$MODE" in
    --loot-only)   push_loot "$TOKEN" "$REPO" "$MSG" ;;
    --repo-only)   push_repo "$TOKEN" "$REPO" "$MSG" ;;
    --all|*)
        push_loot "$TOKEN" "$REPO" "[loot] $MSG"
        push_repo "$TOKEN" "$REPO" "[os] $MSG"
        ;;
esac
