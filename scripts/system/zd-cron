#!/bin/bash
# /usr/local/bin/zd-cron
# ZERO-DAY OS — On-device task orchestrator
# Schedules and runs hacking tasks based on time, battery, and power profile.
# Acts as the local cron brain for the collective-fleet-cron-orchestration.
#
# Usage: zd-cron [start|stop|status|list|run <task>|reload|edit]
#
# Config: /opt/cardputer/config/zd-cron.conf
# Format: <interval_sec> <batt_min_%> <power_profile> <command...>
#   interval_sec  — seconds between runs (0 = run once on start only)
#   batt_min_%    — minimum battery % required (0 = always)
#   power_profile — performance|balanced|stealth|any
#   command       — full command to execute
# Example:
#   300   20   any        wifi-survey-log wlan0 60
#   900   30   balanced   ragnar-scan wlan0 quick
#   3600  15   stealth    loot-organize compress
#   600   40   any        fleet-beacon ping

set -euo pipefail

CONF="/opt/cardputer/config/zd-cron.conf"
PID_FILE="/tmp/zd-cron.pid"
LOG_FILE="/opt/cardputer/loot/general/zd-cron.log"
STATE_DIR="/tmp/zd-cron-state"
LOCK_FILE="/tmp/zd-cron.lock"
MAX_PARALLEL=2

RED='\033[0;31m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
DIM='\033[2m'
NC='\033[0m'

# ── helpers ───────────────────────────────────────────────────────────────────

log() { echo "[$(date '+%H:%M:%S')] $*" | tee -a "$LOG_FILE"; }
log_ok()   { echo -e "${GREEN}[+]${NC} $*" | tee -a "$LOG_FILE"; }
log_warn() { echo -e "${YELLOW}[!]${NC} $*" | tee -a "$LOG_FILE"; }
log_err()  { echo -e "${RED}[!]${NC} $*" | tee -a "$LOG_FILE"; }
log_info() { echo -e "${CYAN}[*]${NC} $*" | tee -a "$LOG_FILE"; }

mkdir -p "$(dirname "$LOG_FILE")" "$STATE_DIR"

get_battery() {
    local cap
    cap=$(cat /sys/class/power_supply/*/capacity 2>/dev/null | head -1)
    echo "${cap:-100}"
}

get_power_profile() {
    local gov
    gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "ondemand")
    case "$gov" in
        performance) echo "performance" ;;
        powersave)   echo "stealth" ;;
        *)           echo "balanced" ;;
    esac
}

profile_matches() {
    local required="$1"
    local current="$2"
    [ "$required" = "any" ] && return 0
    [ "$required" = "$current" ] && return 0
    return 1
}

task_id() {
    # stable ID from first 40 chars of command
    echo "$*" | head -c 40 | tr ' /' '__'
}

last_run_file() {
    echo "${STATE_DIR}/last_$(task_id "$@")"
}

seconds_since_last_run() {
    local f
    f="$(last_run_file "$@")"
    if [ ! -f "$f" ]; then echo 999999; return; fi
    local then
    then=$(cat "$f")
    echo $(( $(date +%s) - then ))
}

mark_run() {
    date +%s > "$(last_run_file "$@")"
}

running_jobs() {
    find "$STATE_DIR" -name 'running_*' 2>/dev/null | wc -l
}

# ── core scheduler loop ───────────────────────────────────────────────────────

run_scheduler() {
    log_info "zd-cron started (PID $$)"
    echo $$ > "$PID_FILE"
    trap 'cleanup' EXIT TERM INT

    while true; do
        [ ! -f "$CONF" ] && { sleep 60; continue; }

        local batt profile
        batt=$(get_battery)
        profile=$(get_power_profile)

        # Rate-limit: skip tick if we already have MAX_PARALLEL jobs running
        local running
        running=$(running_jobs)

        while IFS= read -r line || [ -n "$line" ]; do
            # Skip blanks and comments
            [[ "$line" =~ ^[[:space:]]*$ ]] && continue
            [[ "$line" =~ ^# ]] && continue

            local interval batt_min req_profile cmd_rest
            read -r interval batt_min req_profile cmd_rest <<< "$line" 2>/dev/null || continue

            # Validate fields
            [[ "$interval" =~ ^[0-9]+$ ]] || continue
            [[ "$batt_min" =~ ^[0-9]+$ ]] || continue

            # Battery gate
            if [ "$batt" -lt "$batt_min" ]; then
                log_warn "Skipping [$cmd_rest]: battery ${batt}% < ${batt_min}%"
                continue
            fi

            # Power profile gate
            profile_matches "$req_profile" "$profile" || continue

            # Interval gate (0 = startup-only, already handled by mark on first seen)
            local elapsed
            elapsed=$(seconds_since_last_run "$cmd_rest")
            if [ "$interval" -gt 0 ] && [ "$elapsed" -lt "$interval" ]; then
                continue
            fi

            # Parallel limit
            running=$(running_jobs)
            if [ "$running" -ge "$MAX_PARALLEL" ]; then
                log_warn "Max parallel ($MAX_PARALLEL) reached — deferring [$cmd_rest]"
                continue
            fi

            # Launch in background
            local tid
            tid=$(task_id "$cmd_rest")
            local run_flag="${STATE_DIR}/running_${tid}"
            touch "$run_flag"
            mark_run "$cmd_rest"

            (
                log_info "RUN [${cmd_rest}]  batt=${batt}%  profile=${profile}"
                local t0
                t0=$(date +%s)
                local out
                out=$(bash -c "$cmd_rest" 2>&1) && {
                    local t1
                    t1=$(date +%s)
                    log_ok "DONE [${cmd_rest}]  $(( t1-t0 ))s"
                    echo "$out" >> "$LOG_FILE"
                } || {
                    log_err "FAIL [${cmd_rest}]  exit=$?"
                    echo "$out" >> "$LOG_FILE"
                }
                rm -f "$run_flag"
            ) &
        done < "$CONF"

        sleep 30
    done
}

cleanup() {
    log_info "zd-cron shutting down"
    rm -f "$PID_FILE"
    rm -f "${STATE_DIR}"/running_*
}

# ── subcommands ───────────────────────────────────────────────────────────────

cmd_start() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo -e "${YELLOW}[!] zd-cron already running (PID $(cat "$PID_FILE"))${NC}"
        exit 0
    fi
    if [ ! -f "$CONF" ]; then
        cmd_init_conf
    fi
    run_scheduler >> "$LOG_FILE" 2>&1 &
    disown
    sleep 1
    if [ -f "$PID_FILE" ]; then
        echo -e "${GREEN}[+] zd-cron started (PID $(cat "$PID_FILE"))${NC}"
    else
        echo -e "${RED}[!] Failed to start${NC}"
        exit 1
    fi
}

cmd_stop() {
    if [ ! -f "$PID_FILE" ]; then
        echo -e "${YELLOW}[!] Not running${NC}"; exit 0
    fi
    local pid
    pid=$(cat "$PID_FILE")
    kill "$pid" 2>/dev/null && echo -e "${GREEN}[+] Stopped (PID $pid)${NC}" || echo -e "${YELLOW}[!] Already stopped${NC}"
    rm -f "$PID_FILE"
}

cmd_status() {
    echo -e "${CYAN}╔══════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║     zd-cron — ZERO-DAY Task Scheduler   ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════╝${NC}"
    echo ""

    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo -e "  Scheduler:  ${GREEN}running${NC}  (PID $(cat "$PID_FILE"))"
    else
        echo -e "  Scheduler:  ${RED}stopped${NC}"
    fi

    local batt profile
    batt=$(get_battery)
    profile=$(get_power_profile)
    echo "  Battery:    ${batt}%"
    echo "  Profile:    ${profile}"
    echo "  Running:    $(running_jobs) jobs"
    echo ""

    if [ -f "$CONF" ]; then
        echo -e "  ${CYAN}Scheduled tasks:${NC}"
        local n=0
        while IFS= read -r line || [ -n "$line" ]; do
            [[ "$line" =~ ^[[:space:]]*$ ]] && continue
            [[ "$line" =~ ^# ]] && continue
            local interval batt_min req_profile cmd_rest
            read -r interval batt_min req_profile cmd_rest <<< "$line" 2>/dev/null || continue
            local elapsed
            elapsed=$(seconds_since_last_run "$cmd_rest")
            local next
            if [ "$interval" -eq 0 ]; then
                next="startup-only"
            elif [ "$elapsed" -ge "$interval" ]; then
                next="due-now"
            else
                next="in $(( interval - elapsed ))s"
            fi
            printf "  %-35s  batt≥%3s%%  %-11s  next:%s\n" "$cmd_rest" "$batt_min" "$req_profile" "$next"
            n=$(( n + 1 ))
        done < "$CONF"
        echo "  ($n tasks configured)"
    else
        echo -e "  ${YELLOW}No config at $CONF — run: zd-cron init${NC}"
    fi
    echo ""
    echo -e "  ${DIM}Log: $LOG_FILE${NC}"
}

cmd_list() {
    [ -f "$CONF" ] || { echo "[!] No config: $CONF"; exit 1; }
    grep -v '^#' "$CONF" | grep -v '^[[:space:]]*$' || echo "(empty)"
}

cmd_run() {
    local task="${*:-}"
    [ -z "$task" ] && { echo "Usage: zd-cron run <task>"; exit 1; }
    log_info "Manual run: $task"
    bash -c "$task"
}

cmd_reload() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        kill -HUP "$(cat "$PID_FILE")" 2>/dev/null && echo "[+] Reload signal sent" || echo "[!] Failed"
    else
        echo "[!] Not running"
    fi
}

cmd_edit() {
    [ -f "$CONF" ] || cmd_init_conf
    ${EDITOR:-nano} "$CONF"
}

cmd_logs() {
    local n="${1:-30}"
    tail -n "$n" "$LOG_FILE" 2>/dev/null || echo "(no log yet)"
}

cmd_init_conf() {
    mkdir -p "$(dirname "$CONF")"
    cat > "$CONF" << 'EOF'
# zd-cron.conf — Zero-Day OS on-device task scheduler
# Format: <interval_sec> <batt_min_%> <power_profile> <command...>
#   interval_sec  0 = run once at start only
#   batt_min_%    minimum battery % required (0 = always run)
#   power_profile performance | balanced | stealth | any

# ── Passive intel (always on) ─────────────────────────────
# WiFi survey for 60s every 5 min, needs ≥20% battery
300    20   any         wifi-survey-log wlan0 60

# ── Network recon (balanced/performance only) ─────────────
# Quick network recon every 15 min, ≥30% battery
900    30   balanced    ragnar-scan auto quick

# ── Fleet beacon ─────────────────────────────────────────
# Announce presence to fleet every 2 min
120    10   any         fleet-beacon ping

# ── Loot maintenance ──────────────────────────────────────
# Organize loot every hour
3600   5    any         loot-organize organize

# ── Battery-saving compression at night ───────────────────
# Compress old loot files every 6 hours if on stealth
21600  5    stealth     loot-organize compress

# ── Auto-recon on new network ─────────────────────────────
# Full auto-recon sweep every 30 min on performance mode
1800   40   performance auto-recon full

# ── MAC rotation for stealth ──────────────────────────────
# Rotate MAC every 10 min in stealth mode
600    10   stealth     mac-rotate wlan0
EOF
    echo -e "${GREEN}[+] Config created: $CONF${NC}"
    echo ""
    echo "Edit with: zd-cron edit"
}

# ── main ──────────────────────────────────────────────────────────────────────

case "${1:-status}" in
    start|--start|-s)      cmd_start ;;
    stop|--stop|-S)        cmd_stop ;;
    status|--status)       cmd_status ;;
    list|--list|-l)        cmd_list ;;
    run|--run)             shift; cmd_run "$@" ;;
    reload|--reload|-r)    cmd_reload ;;
    edit|--edit|-e)        cmd_edit ;;
    logs|--logs)           shift; cmd_logs "${1:-30}" ;;
    init|--init)           cmd_init_conf ;;
    *)
        echo "Usage: zd-cron <command>"
        echo ""
        echo "Commands:"
        echo "  start     — Start the task scheduler daemon"
        echo "  stop      — Stop the scheduler"
        echo "  status    — Show scheduler + task status"
        echo "  list      — List configured tasks"
        echo "  run <cmd> — Run a task immediately"
        echo "  reload    — Reload config without restart"
        echo "  edit      — Open config in editor"
        echo "  logs [n]  — Show last n log lines (default 30)"
        echo "  init      — Create default config"
        echo ""
        echo "Config: $CONF"
        exit 1
        ;;
esac
